{
  "name": "@justinforfun/redo-skill",
  "version": "0.1.2",
  "description": "Install the redo skill for Codex, Codex CLI, and Claude Code.",
  "type": "module",
  "keywords": [
    "ai",
    "skill",
    "codex",
    "codex-cli",
    "claude-code",
    "redo",
    "reverse-learning",
    "engineering-tradeoffs"
  ],
  "bin": {
    "redo-skill": "bin/install.js"
  },
  "files": [
    "README.md",
    "bin/",
    "skills/redo/"
  ],
  "engines": {
    "node": ">=18"
