{
  "name": "@justinforfun/soap-skill",
  "version": "1.0.0",
  "description": "Friction happens.Soap it. Evidence-backed development collaboration retrospectives for Codex and other agents.",
  "type": "module",
  "keywords": [
    "ai",
    "skill",
    "codex",
    "claude-code",
    "soap",
    "retrospective",
    "ai-sdlc"
  ],
  "bin": {
    "soap-skill": "./bin/install.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "bin/",
    "skills/soap/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/sync-skill-package.js soap packages/soap-skill && node -e \"require('fs').copyFileSync('../../skills/soap/LICENSE', 'LICENSE')\"",
    "check": "node --check bin/install.js && python3 test/report_test.py && node test/install.test.js",
    "prepack": "npm run build",
    "start": "node bin/install.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "inquirer": "^9.2.23",
    "ora": "^8.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
