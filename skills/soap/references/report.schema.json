{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SOAP retrospective report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "report_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "title",
        "scope"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "agent": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "branch",
        "agent"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "complete"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "partial",
                "insufficient"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "limitations"
          ],
          "additionalProperties": false
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0
    },
    "practices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/practice"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "task",
    "context",
    "coverage",
    "summary",
    "findings",
    "practices"
  ],
  "additionalProperties": false,
  "$defs": {
    "dimension": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "goal_scope",
                "context_constraints",
                "understanding_decisions",
                "implementation_verification",
                "tools_environment",
                "communication_collaboration"
              ]
            },
            "detail": {
              "type": "null"
            }
          },
          "required": [
            "code",
            "detail"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "const": "other"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "code",
            "detail"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "summary",
        "source"
      ],
      "additionalProperties": false
    },
    "recommendation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "change",
        "target",
        "applicability",
        "verification"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "minItems": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "cause": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "supported",
                "inferred",
                "unknown"
              ]
            },
            "explanation": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "explanation"
          ],
          "additionalProperties": false
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recommendation"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "dimensions",
        "observation",
        "evidence",
        "cause",
        "impact",
        "recommendations"
      ],
      "additionalProperties": false
    },
    "practice": {
      "type": "object",
      "properties": {
        "practice": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "practice",
        "evidence",
        "applicability"
      ],
      "additionalProperties": false
    }
  }
}
